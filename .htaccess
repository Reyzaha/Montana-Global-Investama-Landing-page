# PT MONTANA GLOBAL INVESTAMA — URL REWRITE & SECURITY SHIELD
RewriteEngine On
# Preserve HTTP Authorization Header across Apache/mod_php/mod_proxy
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]



# Disable GZIP and Buffering for Realtime SSE Streams
<FilesMatch "stream\.php$">
    SetEnv no-gzip 1
</FilesMatch>

# 0. PHP Upload Limits (Maksimal 32MB)
<IfModule mod_php.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
</IfModule>

# 1. BLOKIR AKSES KE /admin ATAU /admin/ APAPUN
# Alihkan siapa saja yang mencoba mengakses /admin langsung ke homepage publik (301 Permanent Redirect)
RewriteRule ^admin(/.*)?$ /index.html [R=301,L]

# 2. BLOKIR TOTAL FOLDER SENSITIF & BACKUP (403 Forbidden)
RewriteRule ^(database|backups|deploy|nginx|scratch|scripts)(\/.*)?$ - [F,NC,L]

# 3. BLOKIR SKRIP UTILITAS DATABASE & SEEDER
RewriteRule ^(sync_db\.php|seed\.php|clean_dummy\.php|reset_admin\.php|export_full_database\.php|database\/.*\.php)$ - [F,NC,L]

# 4. BLOKIR FILE DENGAN EKSTENSI SENSITIF (.sql, .env, .ini, .log, .bak, .backup, dll.)
<FilesMatch "\.(sql|env|env\..*|ini|log|bak|backup|sh|md|yml|yaml)$">
    Require all denied
</FilesMatch>

# 5. Block direct access to hidden files/folders (.git, .env, etc.)
RewriteRule (^\.|/\.) - [F]

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Anti-Stale Cache Control (Bebas Hard Refresh / Ctrl+Shift+R)
<IfModule mod_headers.c>
    # File dinamis (HTML, PHP, JSON) tidak pernah disimpan di disk cache browser
    <FilesMatch "\.(html|htm|php|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Script & Stylesheet (JS, CSS) harus selalu divalidasi ke server saat ada pembaruan
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# 5. API Endpoints Routing
RewriteRule ^api/investor/projects/?$ api/investor/projects.php [QSA,L]
RewriteRule ^api/projects/([^/]+)/dashboard/?$ api/projects/router.php?project_id=$1&action=dashboard [QSA,L]
RewriteRule ^api/projects/([^/]+)/billing/?$ api/projects/router.php?project_id=$1&action=billing [QSA,L]
RewriteRule ^api/projects/([^/]+)/purchases/?$ api/projects/router.php?project_id=$1&action=purchases [QSA,L]
RewriteRule ^api/projects/([^/]+)/sales/?$ api/projects/router.php?project_id=$1&action=sales [QSA,L]
RewriteRule ^api/projects/([^/]+)/costs/?$ api/projects/router.php?project_id=$1&action=costs [QSA,L]
RewriteRule ^api/projects/([^/]+)/inventory/?$ api/projects/router.php?project_id=$1&action=inventory [QSA,L]
RewriteRule ^api/projects/([^/]+)/documents/?$ api/projects/router.php?project_id=$1&action=documents [QSA,L]
RewriteRule ^api/projects/([^/]+)/stream/?$ api/projects/router.php?project_id=$1&action=stream [QSA,L]


# 6. Clean URLs & Error Pages
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]
