# ==============================================================================
# PT MONTANA GLOBAL INVESTAMA — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan dengan kredensial server produksi.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLIKASI
# ------------------------------------------------------------------------------
APP_NAME="PT Montana Global Investama"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://montanainvestama.com

# ------------------------------------------------------------------------------
# 2. DATABASE UTAMA (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=mgi_landing
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------------------
# 3. REALTIME SYNCHRONIZATION ENGINE (SSE / Polling Fallback)
# ------------------------------------------------------------------------------
# Opsi driver: sse (Server-Sent Events) atau polling
REALTIME_DRIVER=sse
REALTIME_PING_INTERVAL=15
REALTIME_POLL_INTERVAL=30

# ------------------------------------------------------------------------------
# 4. EMAIL / NOTIFIKASI (SMTP & RESEND API)
# ------------------------------------------------------------------------------
# Driver email: smtp atau resend
MAIL_DRIVER=smtp
LEAD_NOTIFY_EMAIL=contact@montanainvestama.com
OFFICIAL_EMAIL=contact@montanainvestama.com

# Konfigurasi SMTP (Default: Hostinger / Google Workspace / VPS Mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=contact@montanainvestama.com
SMTP_PASS=YourStrongSmtpPasswordHere
SMTP_FROM_NAME="PT Montana Global Investama"

# Alternatif: Layanan API Resend (Opsional jika MAIL_DRIVER=resend)
RESEND_API_KEY=re_1234567890abcdef

# ------------------------------------------------------------------------------
# 5. MONITORING & ERROR TRACKING (Sentry / Opsional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 6. KEAMANAN & SESI
# ------------------------------------------------------------------------------
SESSION_LIFETIME=86400
ALLOWED_ORIGINS="https://montanainvestama.com,https://admin.montanainvestama.com"
